---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

interface Props {
    src: ImageMetadata;
    darkSrc?: ImageMetadata;
    alt: string;
    eager?: boolean;
}

const { src, darkSrc, alt, eager = false } = Astro.props;
const widths = [320, 640, 960];
const sizes = '(min-width: 960px) 320px, 70vw';
const dark = darkSrc ? await getImage({ src: darkSrc, widths, sizes, format: 'webp' }) : undefined;
---

<figure class="phone">
    <picture>
        {
            dark && (
                <source
                    media="(prefers-color-scheme: dark)"
                    srcset={dark.srcSet.attribute}
                    sizes={sizes}
                    type="image/webp"
                />
            )
        }
        <Image
            src={src}
            alt={alt}
            widths={widths}
            sizes={sizes}
            format="webp"
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : 'auto'}
        />
    </picture>
</figure>

<style>
    .phone {
        width: min(100%, 20rem);
        margin: 0;
        padding: 0.6rem;
        border-radius: 2.6rem;
        background: var(--ink);
        box-shadow:
            0 1px 0 1px oklch(0 0 0 / 0.08),
            0 30px 60px -30px oklch(0.3 0.05 40 / 0.45);
    }

    .phone :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 390 / 844;
        border-radius: 2rem;
    }
</style>
