---
import { siteConfig } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="container footer-inner">
        <p>© {year} Tandra. Open source under the AGPL-3.0 licence.</p>
        <nav aria-label="Footer">
            <a href={siteConfig.appUrl} data-umami-event="open_app" data-umami-event-placement="footer">Open app</a>
            <a href={siteConfig.repoUrl} data-umami-event="view_code" data-umami-event-placement="footer">GitHub</a>
            <a href={`${siteConfig.repoUrl}/issues`} data-umami-event="report_issue" data-umami-event-placement="footer"
                >Issues</a
            >
            <a href="/recipe/">Recipes</a>
            <a href="/privacy">Privacy</a>
        </nav>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--rule);
        background: var(--paper-deep);
        font-size: 0.95rem;
    }

    .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 2rem;
    }

    .footer p {
        margin: 0;
        color: var(--ink-soft);
    }

    .footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
    }

    .footer a {
        color: var(--ink);
        font-weight: 600;
    }
</style>
