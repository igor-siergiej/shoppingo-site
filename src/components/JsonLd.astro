---
interface Props {
    schema: Record<string, unknown>;
}

const { schema } = Astro.props;
// Recipe pages carry text from the public Discover API, including user-published recipes. `<` is escaped so a value
// containing `</script>` can't end the element early; JSON parsers read `\u003c` back as `<`.
const json = JSON.stringify({ '@context': 'https://schema.org', ...schema }).replaceAll('<', '\\u003c');
---

<script type="application/ld+json" set:html={json} />
