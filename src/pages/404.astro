---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Page not found">
  <div class="container mx-auto flex min-h-[60vh] flex-col items-center justify-center gap-4 py-24 text-center">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="text-muted-foreground text-lg">This page doesn’t exist. If you were looking for your lists, open the app.</p>
    <a href="/" class="text-primary underline underline-offset-4">Go to the Shoppingo homepage</a>
  </div>
</Layout>
