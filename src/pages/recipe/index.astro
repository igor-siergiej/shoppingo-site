---
import PageHeader from '@/components/PageHeader.astro';
import { siteConfig } from '@/config/site';
import Layout from '@/layouts/Layout.astro';
import { getRecipes, readableDuration } from '@/lib/discover';

export const prerender = true;

const recipes = await getRecipes();
---

<Layout
    title="Free recipes from the Tandra library"
    description="Recipes from the Tandra Discover library, most of them from the Wikibooks Cookbook. Open any recipe in Tandra to add its ingredients to your shopping list."
>
    <section class="container recipes" aria-labelledby="recipes-title">
        <PageHeader eyebrow={{ label: 'Tandra', href: '/' }} title="Recipes" titleId="recipes-title">
            <p class="lede">
                A selection from the {siteConfig.name} Discover library. Open the app to search all of it, copy a recipe into
                your own collection or add its ingredients to a shared list.
            </p>
        </PageHeader>

        <ul class="grid">
            {
                recipes.map((recipe) => {
                    const time = (recipe.prepTime ?? 0) + (recipe.cookTime ?? 0);
                    return (
                        <li>
                            <a href={`/recipe/${recipe.slug}/`}>
                                <span class="title">{recipe.title}</span>
                                <span class="meta">
                                    {[time && readableDuration(time), recipe.servings && `serves ${recipe.servings}`]
                                        .filter(Boolean)
                                        .join(' · ')}
                                </span>
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </section>
</Layout>

<style>
    .recipes {
        padding-block: 3rem 5rem;
    }

    .lede {
        max-width: 50rem;
        margin: 1.25rem 0 0;
        color: var(--ink-soft);
        font-size: 1.2rem;
        line-height: 1.55;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        gap: 1rem;
        margin: 2.5rem 0 0;
        padding: 0;
        list-style: none;
    }

    .grid a {
        display: grid;
        gap: 0.35rem;
        height: 100%;
        padding: 1.1rem 1.25rem;
        border: 1px solid var(--rule);
        border-radius: 1rem;
        color: var(--ink);
        text-decoration: none;
        transition: border-color 0.15s ease;
    }

    .grid a:hover {
        border-color: var(--forest);
    }

    .title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .meta {
        color: var(--ink-soft);
        font-size: 0.95rem;
    }
</style>
